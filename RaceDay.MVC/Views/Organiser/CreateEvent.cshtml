<h2>Create Event</h2>
<form method="post" enctype="multipart/form-data">
    <label>Name</label><input name="Name" class="form-control" />
    <label>Description</label><input name="Description" class="form-control" />
    <label>Date</label><input name="Date" type="date" class="form-control" />
    <label>Location</label><input name="Location" class="form-control" />
    <label>Distance</label><input name="Distance" type="number" step="0.1" class="form-control" />
    <label>Event Type</label><input name="EventType" class="form-control" placeholder="5K, 10K, Marathon" />
    <label>Banner Image</label><input name="BannerImage" type="file" class="form-control" />
    <button class="btn btn-primary mt-3">Create</button>
</form>