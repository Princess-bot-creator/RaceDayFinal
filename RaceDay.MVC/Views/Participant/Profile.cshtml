<h2>Profile</h2>
<form method="post" enctype="multipart/form-data">
    <label>Full Name</label><input name="FullName" class="form-control" />
    <label>Email</label><input name="Email" class="form-control" />
    <label>Profile Picture</label><input name="ProfilePicture" type="file" class="form-control" />
    <button class="btn btn-primary mt-3">Save</button>
</form>